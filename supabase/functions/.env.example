# Secrets for local `supabase functions serve --env-file ./supabase/functions/.env`
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are provided
# automatically by the local runtime; you only need ENCRYPTION_KEY here.
ENCRYPTION_KEY=replace-with-a-long-random-string

# ---- Hosted AI (Pro tier) — all optional -----------------------------------
# Leave unset on a self-hosted stack: daily-summary then advertises
# `server.hosted_ai: false` and the app never shows Pro UI.
# HOSTED_LLM_PROVIDER=anthropic        # any built-in provider id (not "custom")
# HOSTED_LLM_KEY=sk-...                # the operator's key that Pro users run on
# HOSTED_LLM_MODEL=                    # optional; empty -> provider default
# HOSTED_AI_DISABLED=                  # set to anything to kill hosted AI instantly
# Cost rails (defaults: 30 calls/h, $0.25/day, $2/mo per user, $25/mo global).
# Sizing rule for ~5 EUR/mo Pro: global ~= 10 + 2.5 x paying subscribers.
# HOSTED_USER_HOURLY_CALLS=30
# HOSTED_USER_DAILY_USD=0.20
# HOSTED_USER_MONTHLY_USD=2
# HOSTED_GLOBAL_MONTHLY_USD=25

# ---- Play Billing (verify-purchase / play-rtdn) -----------------------------
# GOOGLE_PLAY_SA_JSON={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}
# ANDROID_PACKAGE_NAME=com.workoutmaker.app
# PLAY_RTDN_SECRET=long-random-string   # must match ?secret= in the Pub/Sub push URL
