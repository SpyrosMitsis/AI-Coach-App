# ============================================================================
# Workout Maker — environment variables (all components)
# ============================================================================

# --- Supabase project (from `supabase projects api-keys` or the dashboard) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY   # server-only, never ship to clients

# --- Edge Function secrets (set with `supabase secrets set ...`) -------------
# 32+ char symmetric key used by pgcrypto to encrypt/decrypt user API keys.
# Generate once:  openssl rand -base64 48
ENCRYPTION_KEY=replace-with-a-long-random-string

# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# into Edge Functions automatically by the platform; ENCRYPTION_KEY is the only
# secret you must set yourself.

# --- Web app (Vercel) — public, anon-safe only -------------------------------
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# --- Android (android/local.properties or gradle.properties) -----------------
# SUPABASE_URL=...
# SUPABASE_ANON_KEY=...

# NOTE: Users bring their own LLM + Intervals.icu keys at runtime — there are
# NO platform-level provider keys here. That's what keeps hosting free forever.
