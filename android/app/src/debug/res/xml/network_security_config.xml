<?xml version="1.0" encoding="utf-8"?>
<!--
  Local development only (this file ships in DEBUG builds only): allow
  plain-HTTP to a local Supabase instance. Production uses
  https://<ref>.supabase.co, which needs none of this. For a physical device,
  add your PC's LAN IP below — just don't commit it.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
