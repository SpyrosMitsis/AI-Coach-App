<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material3 + edge-to-edge; Compose drives the real colors. Dark by default. -->
    <style name="Theme.WorkoutMaker" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#0A0A0B</item>
        <item name="android:navigationBarColor">#0A0A0B</item>
        <item name="android:windowBackground">#0A0A0B</item>
    </style>

    <!-- Launch theme: the system splash shows the breath-rings mark on the same
         near-black, then hands off to Theme.WorkoutMaker seamlessly. -->
    <style name="Theme.WorkoutMaker.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A0A0B</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.WorkoutMaker</item>
        <item name="android:statusBarColor">#0A0A0B</item>
        <item name="android:navigationBarColor">#0A0A0B</item>
    </style>
</resources>
